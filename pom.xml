<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/>
	</parent>

	<groupId>com.tdtu.soa</groupId>
	<artifactId>ibanking-tuition-soa</artifactId>
	<version>1.0.0</version>
	<packaging>pom</packaging>
	
	<name>ibanking-tuition-soa</name>
	<description>Phân hệ đóng học phí iBanking TDTU - Kiến trúc Microservices (SOA CS504070)</description>

	<developers>
		<developer>
			<id>524H0122</id>
			<name>Nguyễn Anh Quân</name>
			<email>524h0122@student.tdtu.edu.vn</email>
			<organization>Ton Duc Thang University</organization>
		</developer>
	</developers>

	<modules>
		<module>common-dto</module>
		<module>account-service</module>
		<module>tuition-service</module>
		<module>otp-service</module>
		<module>payment-service</module>
		<module>gateway-service</module>
	</modules>

	<properties>
		<java.version>21</java.version>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<jjwt.version>0.12.6</jjwt.version>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
	</dependencies>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.springframework.boot</groupId>
					<artifactId>spring-boot-maven-plugin</artifactId>
					<configuration>
						<excludes>
							<exclude>
								<groupId>org.projectlombok</groupId>
								<artifactId>lombok</artifactId>
							</exclude>
						</excludes>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>
</project>

